      "predictiveBackGestureEnabled": false,
      "package": "com.qwepablo12.eatwise"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "a1748d1a-6734-4cb9-9fd1-35e39770d30f"
      }
    },
    "owner": "12qwepablo"
  }
}
